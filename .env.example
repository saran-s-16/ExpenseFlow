# ===================================================
# ExpenseFlow - Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file with actual secrets.
# ===================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=expenseflow_db
DB_USER=postgres
DB_PASSWORD=your_database_password_here

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# AI Assistant Configuration (Groq API)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Optional / Legacy AI Provider Configuration (OpenAI API)
# OPENAI_API_KEY=sk-your_openai_api_key_here
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_MAX_OUTPUT_TOKENS=600
