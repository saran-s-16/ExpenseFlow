{
    "name": "expenseflow",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "install:server": "npm --prefix server install",
        "install:client": "npm --prefix client install",
        "build": "npm --prefix server install",
        "start": "node server/server.js",
        "dev": "npm run dev:client",
        "dev:server": "npm run dev:server",
        "dev:client": "npm run dev:client",
        "db:init": "npm --prefix server run db:init",
        "db:seed:demo": "npm --prefix server run db:seed:demo",
        "db:seed:dedicated-demo": "npm --prefix server run db:seed:dedicated-demo",
        "db:restore": "npm --prefix server run db:restore",
        "test:verify": "npm --prefix server run test:verify"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}